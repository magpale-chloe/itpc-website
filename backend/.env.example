# Configure these on the backend server. Do not commit real passwords.
ITPC_USERNAME=your-executive-board-username
ITPC_PASSWORD=your-strong-password

# Shared Committee login: can view everyone's duty hours but cannot edit anything.
COMMITTEE_USERNAME=your-committee-username
COMMITTEE_PASSWORD=another-strong-password

# MongoDB connection string. Include the database name in the path, or set MONGODB_DB_NAME.
# Local example: mongodb://localhost:27017/itpc_photobooth
# Atlas example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/itpc_photobooth
MONGODB_URI=mongodb://localhost:27017/itpc_photobooth
# Optional: overrides the database name in MONGODB_URI.
# MONGODB_DB_NAME=itpc_photobooth

# Secret used to sign login sessions so they survive server restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
